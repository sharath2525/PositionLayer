# All settings below are server-only. Never prefix a credential with NEXT_PUBLIC_.
# No environment file is needed for explicit Sample mode or keyless public Stocks.
# Live is the default UI mode; configure a reliable RPC for public-address reads.
# The market worker/cache/logs are process-local: deploy one persistent Node instance.
# The public default is rate-limited; a personal RPC with indexed reads is useful.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
APP_CLUSTER=solana:mainnet
# Optional server-side Jupiter key for read APIs and the Phase 2 quote-only
# /swap/v2/order call. Keyless mode works at the documented lower rate limit;
# never expose this value through NEXT_PUBLIC_*.
# JUPITER_API_KEY=
# Optional fixed browser-facing origin for an HTTPS reverse proxy. No trailing path.
# APP_ORIGIN=https://your-own-domain.example

# Temporary process-local market monitoring. It retains sanitized events for no
# more than six hours and never writes them to permanent storage.
MARKET_MONITORING_ENABLED=true
# Phase 2 compatibility flags. Set either to false for an immediate rollback to
# the approved Jupiter/xStocks behavior. Values are public-policy settings only;
# no provider credentials are used.
MARKET_RESOLVER_V2=true
METEORA_MARKET_ENABLED=true
# Freshness windows: LIVE 45s, DELAYED through 2m, STALE through 10m.
MARKET_LIVE_MS=45000
MARKET_DELAYED_MS=120000
MARKET_STALE_MS=600000
# Exact-mint USDC pools below this TVL remain ineligible for comparison.
METEORA_MIN_LIQUIDITY_USD=1000
# Comparison threshold is informational and never changes the selected price.
MARKET_DIVERGENCE_THRESHOLD_PCT=5
# The unlinked health page is fail-closed unless all three values are configured.
# Use a long unique password and expose this route only behind HTTPS.
ADMIN_HEALTH_ENABLED=false
# ADMIN_HEALTH_USERNAME=
# ADMIN_HEALTH_PASSWORD=

# Optional read-only inspection inputs. Use actual public onchain IDs, never a
# seed phrase or private key. The inspection script cannot sign or submit.
# PROBE_OWNER=
# PROBE_VAULT_ID=
# PROBE_POSITION_ID=
